{
  "name": "core-backend",
  "version": "1.0.0",
  "description": "Secure Delivery & Verification System - Backend Squad A (Core Architecture & Security)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/unit src/tests/integration",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/integration",
    "test:live": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=src/tests/live --runInBand --testTimeout=30000",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testTimeout=30000",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "seed": "node seed.js"
  },
  "keywords": [
    "verification",
    "documents",
    "qr-code",
    "authentication",
    "express",
    "prisma"
  ],
  "author": "Backend Squad A",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "prisma": "^5.22.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
