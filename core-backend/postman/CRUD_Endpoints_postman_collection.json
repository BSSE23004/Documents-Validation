{
  "info": {
    "name": "Secure Delivery & Verification - Digital Assets (Squad A)",
    "_postman_id": "8f6c91a0-5b12-4c28-98e3-0d5b12345678",
    "description": "Postman Collection for Core CRUD Endpoints for Digital Assets (Documents) & Verification Engine as per Technical Specification Section 4.4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "qrCodeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "referenceNumber",
      "value": "DL-2026-001",
      "type": "string"
    },
    {
      "key": "documentTypeId",
      "value": "fb6cf71d-abeb-4b3f-b3c3-b09e30286a29",
      "type": "string"
    },
    {
      "key": "issuerId",
      "value": "de72a0f5-89a2-4f66-aab5-a8a0e781c582",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Prerequisite)",
      "item": [
        {
          "name": "Login (Issuer / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.collectionVariables.set('authToken', jsonData.data.token);",
                  "        console.log('Auth token automatically set to collection variables!');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@devlogix.online\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates user and automatically stores JWT token in collection variable for subsequent requests."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Digital Assets CRUD (Your Task - Section 4.4)",
      "item": [
        {
          "name": "POST Create Document (Section 4.4.1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.document) {",
                  "        pm.collectionVariables.set('documentId', jsonData.data.document.id);",
                  "        pm.collectionVariables.set('qrCodeId', jsonData.data.document.qrCodeId);",
                  "        pm.collectionVariables.set('referenceNumber', jsonData.data.document.referenceNumber);",
                  "        console.log('Saved documentId:', jsonData.data.document.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentTypeId\": \"{{documentTypeId}}\",\n  \"issuerId\": \"{{issuerId}}\",\n  \"recipientName\": \"Jane Smith\",\n  \"recipientEmail\": \"jane@example.com\",\n  \"title\": \"Internship Offer Letter\",\n  \"description\": \"Internship offer for Software Engineer position at DevLogix\",\n  \"referenceNumber\": \"DL-2026-{{$randomInt}}\",\n  \"issuanceDate\": \"2026-08-25T10:00:00Z\",\n  \"expiryDate\": \"2027-12-31T23:59:59Z\",\n  \"metadata\": {\n    \"position\": \"Software Engineer\",\n    \"department\": \"Engineering\",\n    \"salary\": \"75000\",\n    \"startDate\": \"2026-09-01\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"]
            },
            "description": "Creates a new verifiable document with cryptographic QR code ID and triggers Squad B hooks."
          },
          "response": []
        },
        {
          "name": "GET Document by ID (Section 4.4.2)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            },
            "description": "Fetches a single document by UUID with complete relation data (issuer, documentType)."
          },
          "response": []
        },
        {
          "name": "GET All Documents - Paginated (Section 4.4.3)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents?page=1&limit=10&status=active&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "active"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "Lists documents with pagination (default 20, max 100), status filtering, and search keyword scoping."
          },
          "response": []
        },
        {
          "name": "PUT Update Document (Section 4.4.4)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"revoked\",\n  \"description\": \"Updated description: Revoked due to internship completion.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            },
            "description": "Updates document status (e.g. active, revoked, expired) or description/title."
          },
          "response": []
        },
        {
          "name": "DELETE Document (Section 4.4.5)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/documents/{{documentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "documents", "{{documentId}}"]
            },
            "description": "Admin-only endpoint to permanently remove a document and cascade delete its logs."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Verification (Public Endpoints)",
      "item": [
        {
          "name": "POST Verify by QR Code (Section 4.5.1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrCodeId\": \"{{qrCodeId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verify/qr-code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verify", "qr-code"]
            },
            "description": "Public verification endpoint returning status valid, revoked, expired, or invalid."
          },
          "response": []
        },
        {
          "name": "POST Verify by Reference Number (Section 4.5.2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceNumber\": \"{{referenceNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/verify/reference",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verify", "reference"]
            },
            "description": "Public reference number lookup endpoint."
          },
          "response": []
        }
      ]
    }
  ]
}
